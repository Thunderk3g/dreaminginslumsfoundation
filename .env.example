# Postgres. Supabase → Project Settings → Database → Connection string →
# **Session pooler** (port 5432), NOT the direct host and NOT the transaction
# pooler on 6543. See the comment at the top of src/lib/db.ts for why.
DATABASE_URL=

# The CMS console. One shared password for the whole team — there is no user
# management by design. It is also the HMAC key for the admin session cookie,
# so changing it signs everyone out.
ADMIN_PASSWORD=change-me-before-deploying

# Canonical site URL. Swap for the real domain later without a code change.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
